{
  "name": "webinar-commerce-iceberg-PAUSED-TEMPLATE",
  "initial_state": "PAUSED",
  "config": {
    "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
    "tasks.max": "1",
    "topics": "commerce.events.v1",
    "value.converter": "org.apache.kafka.connect.storage.StringConverter",
    "transforms": "stage",
    "transforms.stage.type": "demo.iceberg.EnvelopeToStaging",
    "iceberg.tables": "commerce_stg.kafka_event",
    "iceberg.tables.auto-create-enabled": "false",
    "iceberg.catalog.type": "rest",
    "iceberg.catalog.uri": "https://10.0.2.16/catalog",
    "iceberg.catalog.warehouse": "dlh",
    "iceberg.catalog.rest.auth.type": "demo.iceberg.CiamAuthManager",
    "iceberg.catalog.ciam.credential-file": "/etc/kafka-demo/iceberg-client-credential",
    "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
    "iceberg.catalog.s3.endpoint": "https://hb.ru-msk.vkcloud-storage.ru",
    "iceberg.catalog.client.region": "ru-msk",
    "iceberg.catalog.s3.path-style-access": "true",
    "iceberg.catalog.s3.remote-signing-enabled": "true",
    "iceberg.catalog.header.X-Iceberg-Access-Delegation": "remote-signing",
    "iceberg.control.topic": "REPLACE_WITH_ISOLATED_BUSINESS_CONTROL_TOPIC"
  }
}
